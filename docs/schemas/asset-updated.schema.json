{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lab-data-platform/data-platform/docs/schemas/asset-updated.schema.json",
  "title": "AssetUpdated",
  "description": "Campo detail do evento AssetUpdated publicado no barramento lab-data-<env>-assets (docs/eventos.md).",
  "type": "object",
  "required": [
    "asset",
    "contract_version",
    "partition",
    "load",
    "location",
    "run_id",
    "produced_at"
  ],
  "additionalProperties": false,
  "properties": {
    "asset": {
      "type": "string",
      "pattern": "^(source|bronze|silver|gold|dw|dashboard)(\\.[a-z][a-z0-9_]*){2,6}$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "partition": {
      "type": "string",
      "minLength": 1
    },
    "load": {
      "enum": [
        "replace",
        "upsert",
        "append"
      ],
      "description": "Como o consumidor aplica a atualização"
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "string",
          "description": "sha256 do conteúdo, para detectar dado repetido"
        }
      }
    },
    "location": {
      "type": "string",
      "pattern": "^s3://"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
