{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lab-data-platform/data-platform/docs/schemas/assets.schema.json",
  "title": "assets.yml",
  "description": "Contrato de dados dos assets de um repositório (docs/governanca.md, seção 1).",
  "type": "object",
  "required": ["assets"],
  "additionalProperties": false,
  "properties": {
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "tipo", "descricao", "dono", "classificacao", "depende_de", "versao_contrato"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(api|bronze|silver|gold|dw|dashboard)\\.[a-z0-9_]+(\\.[a-z0-9_]+)?$" },
        "tipo": { "enum": ["fonte-externa", "bronze", "silver", "gold", "dw", "dashboard"] },
        "descricao": { "type": "string", "minLength": 10 },
        "dono": { "type": "string" },
        "classificacao": { "enum": ["publico", "interno", "confidencial", "pessoal"] },
        "depende_de": { "type": "array", "items": { "type": "string" } },
        "produzido_por": { "type": "string" },
        "local": { "type": "string" },
        "tabela": { "type": "string" },
        "frescor_esperado": { "type": "string", "pattern": "^[0-9]+(h|d)$" },
        "versao_contrato": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nome", "tipo", "descricao"],
            "additionalProperties": false,
            "properties": {
              "nome": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
              "tipo": { "type": "string" },
              "descricao": { "type": "string" },
              "obrigatorio": { "type": "boolean" }
            }
          }
        },
        "qualidade": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["regra"],
            "properties": {
              "regra": { "type": "string" },
              "coluna": { "type": "string" },
              "descricao": { "type": "string" }
            }
          }
        }
      },
      "if": { "properties": { "tipo": { "not": { "const": "fonte-externa" } } } },
      "then": { "required": ["produzido_por", "local", "frescor_esperado", "schema", "qualidade"] }
    }
  }
}
